root = true

# All files
[*]
indent_style = space
end_of_line = crlf

# C# files
[*.cs]
indent_style = tab
indent_size = 4
end_of_line = crlf

# XML files
[*.xml]
indent_style = space
indent_size = 2
end_of_line = crlf

# JSON files
[*.json]
indent_style = tab
indent_size = 2
end_of_line = crlf

# Docker files
[Dockerfile]
indent_style = tab
indent_size = 2
end_of_line = crlf
